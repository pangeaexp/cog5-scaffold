   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -e ..\n",
    "from cog5.core import CogSystem\n",
    "cs = CogSystem(n_nodes=12)\n",
    "cs.initialize()\n",
    "cs.save_state('demo_state.json')\n",
    "cs.step_evolution(2)\n",
    "cs.save_state('demo_evolved.json')\n",
    "print('Done')\n"
   ]
  }
